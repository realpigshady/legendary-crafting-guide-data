{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/realpigshady/legendary-crafting-guide-data/schema/pack.schema.json",
  "title": "Legendary Crafting Guide data pack",
  "type": "object",
  "required": [
    "format_version",
    "generated_at",
    "legendaries",
    "nodes",
    "activities"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "all_legendary_item_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "legendaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "name",
          "item_id",
          "root_node_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "family": {
            "enum": [
              "weapon",
              "gen1_weapon",
              "gen2_weapon",
              "gen3_weapon",
              "armor",
              "trinket",
              "back",
              "upgrade",
              "relic"
            ]
          },
          "name": {
            "type": "string"
          },
          "item_id": {
            "type": "integer"
          },
          "root_node_id": {
            "type": "string"
          },
          "weapon_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "armor_set": {
            "type": "string",
            "description": "armor: the 6-slot set this piece belongs to (Perfected Envoy, Triumphant Hero's, Mistforged Triumphant Hero's, Glorious Hero's, Mistforged Glorious Hero's, Ardent Glorious, Obsidian)"
          },
          "weight_class": {
            "enum": [
              "Light",
              "Medium",
              "Heavy"
            ],
            "description": "armor: /v2/items details.weight_class (set together with armor_set)"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "craft",
              "forge",
              "collection",
              "achievement",
              "currency",
              "vendor",
              "drop"
            ]
          },
          "name": {
            "type": "string"
          },
          "item_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "achievement_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "currency_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "inputs"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "trading_post",
                    "vendor",
                    "craft",
                    "mystic_forge",
                    "activity",
                    "reward",
                    "other"
                  ]
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "count"
                    ],
                    "properties": {
                      "node_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "output_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "daily_cap": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "weekly_cap": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "activity_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "disciplines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recipe_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "achievement_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "reward: the achievement/collection that gives it"
                },
                "steps": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "reward: step count when known (else from the API)"
                },
                "step_minutes": {
                  "type": "number",
                  "minimum": 0,
                  "description": "reward: minutes per step (0/absent = default estimate)"
                },
                "expected_output": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "random output: average made per attempt of this source (used instead of output_count); 10x recipes carry ten times the 1x average"
                },
                "max_units": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "at most this many in all (vendor total purchase cap, Wizard's Vault limit)"
                },
                "vendors": {
                  "type": "array",
                  "description": "vendor: who sells it at this price",
                  "items": {
                    "type": "object",
                    "properties": {
                      "npc": {
                        "type": "string"
                      },
                      "locations": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "requires": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "map_id": {
                        "type": "integer",
                        "description": "API map of the first location that resolved"
                      },
                      "map": {
                        "type": "string"
                      },
                      "waypoint_name": {
                        "type": "string"
                      },
                      "waypoint_chat_code": {
                        "type": "string",
                        "description": "nearest waypoint to the vendor's area (official API), for Crafting > Vendor"
                      },
                      "festival": {
                        "type": "string",
                        "description": "this vendor is only there during the festival"
                      }
                    }
                  }
                },
                "achievement_name": {
                  "type": "string",
                  "description": "reward: the achievement's name"
                },
                "wiki_page": {
                  "type": "string",
                  "description": "reward: wiki page of the achievement / collection"
                },
                "festival": {
                  "type": "string",
                  "description": "every vendor selling it this way is festival-only: available only inside that festival's windows"
                },
                "byproducts": {
                  "type": "array",
                  "description": "random forge: average extra items per attempt besides the output (wiki drop research); informational, the addon does not plan with them yet",
                  "items": {
                    "type": "object",
                    "required": [
                      "node_id",
                      "count"
                    ],
                    "properties": {
                      "node_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "count": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "average per attempt (a fraction)"
                      }
                    }
                  }
                },
                "research": {
                  "type": "object",
                  "description": "random forge: where expected_output/byproducts come from",
                  "properties": {
                    "page": {
                      "type": "string"
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "expected_from": {
                      "type": "string",
                      "enum": [
                        "wiki average recipe",
                        "drop research"
                      ]
                    }
                  }
                },
                "cap_group": {
                  "type": "string",
                  "description": "vendor: sources with the same cap_group share one purchase limit (weekly_cap/daily_cap) even at different prices"
                },
                "repeatable": {
                  "type": "boolean",
                  "description": "reward: the achievement can be completed again for the same reward (Glory to the Legions)"
                }
              }
            }
          },
          "guidance": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "wiki_url": {
                "type": "string"
              },
              "waypoint_chat_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "waypoint_name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mode",
          "expansion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "pve",
              "pvp",
              "wvw"
            ]
          },
          "expansion": {
            "type": "string"
          },
          "est_minutes": {
            "type": "number"
          },
          "map_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Maps the activity happens on; the addon matches DRF loot sessions by map."
          },
          "yields": {
            "type": "array"
          },
          "guidance": {
            "type": "object"
          },
          "max_runs_per_day": {
            "type": "integer",
            "minimum": 1,
            "description": "runs that count per play day (daily fractals, hero's choice chests)"
          },
          "max_runs_per_week": {
            "type": "integer",
            "minimum": 1,
            "description": "runs that count per week (raid wings)"
          },
          "gold_per_run": {
            "type": "integer",
            "minimum": 0,
            "description": "copper a run earns (coin + loot value)"
          },
          "masteries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "description": "mastery tracks (/v2/masteries) and levels needed"
          },
          "festival": {
            "type": "string",
            "description": "festival name (pack festivals[].name): only available inside that festival's windows"
          },
          "reward_track": {
            "type": "boolean",
            "description": "a PvP/WvW reward track (untimed until track times are known)"
          },
          "repeatable": {
            "type": "boolean",
            "description": "reward track: can be repeated (false = once per account)"
          },
          "retiring": {
            "type": "boolean",
            "description": "the wiki marks the track as to be removed at a later date"
          },
          "group": {
            "type": "string",
            "description": "variants of one activity: the planner plans at most one activity of a group per play day (missing = its own group)"
          },
          "cap_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "max_runs_per_day": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_runs_per_week": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "description": "rewards shared with other activities: the runs of every activity naming the same id count against one cap (config/shared_caps.json)"
          },
          "description": {
            "type": "string",
            "description": "1-2 lines for the expanded Overview row; the More info link is guidance.wiki_url"
          },
          "info_url": {
            "type": "string",
            "description": "More info link when it isn't guidance.wiki_url"
          },
          "mirror_route": {
            "type": "object",
            "description": "Magic Mirror route visual (Data 4o (1b), SPEC §5): the UI's mirror window. Pixel positions on the route image; image and waypoint_icon are release asset names beside pack.json",
            "required": [
              "map",
              "variant",
              "image",
              "image_size",
              "starts"
            ],
            "properties": {
              "map": {
                "type": "string"
              },
              "variant": {
                "enum": [
                  "full",
                  "efficient"
                ]
              },
              "image": {
                "type": "string"
              },
              "image_size": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "waypoint_icon": {
                "type": "string"
              },
              "wiki_map_url": {
                "type": "string"
              },
              "starts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "chat_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "mirrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "n",
                    "name",
                    "x",
                    "y"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "chests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "size",
                    "x",
                    "y"
                  ],
                  "properties": {
                    "size": {
                      "enum": [
                        "small",
                        "medium",
                        "large",
                        "medium_or_large"
                      ]
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mirror": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              },
              "stops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "n",
                    "kind",
                    "name",
                    "x",
                    "y"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer"
                    },
                    "kind": {
                      "enum": [
                        "mirror",
                        "chest"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "enum": [
                        "small",
                        "medium",
                        "large",
                        "medium_or_large"
                      ]
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "points"
                  ],
                  "properties": {
                    "start": {
                      "type": "string"
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                }
              },
              "path_drawn_by_owner": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "festivals": {
      "type": "array",
      "description": "Recurring festivals and every release window from the festival's wiki page. A source or activity with \"festival\" is available only inside one of its windows; a festival with no window is off.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "windows"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "wiki page title; [fast] 'Requires' names match it ignoring case"
          },
          "wiki_url": {
            "type": "string"
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start"
              ],
              "properties": {
                "release": {
                  "type": "string"
                },
                "start": {
                  "type": "string",
                  "format": "date",
                  "description": "first day (UTC date the festival opens)"
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "description": "day it closes (the release's end date on the wiki); null = not announced yet"
                }
              }
            }
          }
        }
      }
    }
  }
}
