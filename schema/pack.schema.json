{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/realpigshady/legendary-crafting-guide-data/schema/pack.schema.json",
  "title": "Legendary Crafting Guide data pack",
  "type": "object",
  "required": ["format_version", "generated_at", "legendaries", "nodes", "activities"],
  "properties": {
    "format_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "all_legendary_item_ids": { "type": "array", "items": { "type": "integer" } },
    "legendaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "name", "item_id", "root_node_id"],
        "properties": {
          "id": { "type": "string" },
          "family": { "enum": ["gen1_weapon", "gen2_weapon", "gen3_weapon", "armor", "trinket", "back", "upgrade", "relic"] },
          "name": { "type": "string" },
          "item_id": { "type": "integer" },
          "root_node_id": { "type": "string" },
          "weapon_type": { "type": ["string", "null"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "sources"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["craft", "forge", "collection", "achievement", "currency", "vendor", "drop"] },
          "name": { "type": "string" },
          "item_id": { "type": ["integer", "null"] },
          "achievement_id": { "type": ["integer", "null"] },
          "currency_id": { "type": ["integer", "null"] },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "inputs"],
              "properties": {
                "kind": { "enum": ["trading_post", "vendor", "craft", "mystic_forge", "activity", "reward", "other"] },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["count"],
                    "properties": {
                      "node_id": { "type": "string" },
                      "name": { "type": "string" },
                      "count": { "type": "integer", "minimum": 1 }
                    }
                  }
                },
                "output_count": { "type": "integer", "minimum": 1 },
                "daily_cap": { "type": ["integer", "null"] },
                "weekly_cap": { "type": ["integer", "null"] },
                "activity_id": { "type": ["string", "null"] },
                "disciplines": { "type": "array", "items": { "type": "string" } },
                "recipe_id": { "type": ["string", "null"] }
              }
            }
          },
          "guidance": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "wiki_url": { "type": "string" },
              "waypoint_chat_code": { "type": ["string", "null"] },
              "waypoint_name": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "mode", "expansion"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mode": { "enum": ["pve", "pvp", "wvw"] },
          "expansion": { "type": "string" },
          "est_minutes": { "type": "number" },
          "yields": { "type": "array" },
          "guidance": { "type": "object" }
        }
      }
    }
  }
}
